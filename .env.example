# Public API key from https://developers.kite.trade/
KITE_API_KEY=your_api_key

# API secret. Server only. Never prefix this with NEXT_PUBLIC_.
KITE_API_SECRET=your_api_secret

# Must match the redirect URL registered on the Kite Connect app.
KITE_REDIRECT_URL=http://localhost:3000/api/kite/callback

# Signs the HTTP-only session id cookie. Use a long random string.
# The access token is stored in server memory, not in this cookie.
SESSION_SECRET=replace_with_a_long_random_string
